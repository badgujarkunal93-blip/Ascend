rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if requesting user is a Superadmin
    function isSuperAdmin() {
      return request.auth != null && 
        get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'superadmin';
    }

    // Helper function to check if requesting user is an Institution Admin or Superadmin
    function isInstitutionAdmin() {
      return request.auth != null && (
        get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'institution_admin' ||
        get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'superadmin' ||
        get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Institutions Collection (Public read for Login Selector)
    match /institutions/{institutionId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Profiles Collection
    match /profiles/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'institution_id']) || isSuperAdmin());
      allow delete: if isInstitutionAdmin();
    }

    // Questions Collection (Global Question Bank)
    match /questions/{questionId} {
      allow read: if request.auth != null;
      allow write: if isSuperAdmin();
    }

    // Submissions Collection
    match /submissions/{submissionId} {
      allow read: if request.auth != null && (
        resource.data.student_id == request.auth.uid || isInstitutionAdmin()
      );
      allow create: if request.auth != null && 
        request.resource.data.student_id == request.auth.uid;
      allow update, delete: if isInstitutionAdmin();
    }

  }
}
